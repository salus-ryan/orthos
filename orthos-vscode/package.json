{
  "name": "orthos",
  "displayName": "Orthos",
  "description": "Constraint-Topology Description Language support for VS Code",
  "version": "0.1.0",
  "publisher": "orthos",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Other"
  ],
  "activationEvents": [
    "onLanguage:orthos",
    "workspaceContains:**/*.orth"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "orthos",
        "aliases": ["Orthos", "orthos"],
        "extensions": [".orth"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "orthos",
        "scopeName": "source.orthos",
        "path": "./syntaxes/orthos.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "orthos.initialize",
        "title": "Orthos: Initialize Universe",
        "icon": "$(zap)"
      },
      {
        "command": "orthos.checkpoint",
        "title": "Orthos: Create Checkpoint",
        "icon": "$(save)"
      },
      {
        "command": "orthos.restore",
        "title": "Orthos: Restore Checkpoint",
        "icon": "$(discard)"
      },
      {
        "command": "orthos.constrain",
        "title": "Orthos: Add Constraint",
        "icon": "$(lock)"
      },
      {
        "command": "orthos.query",
        "title": "Orthos: Query Flux",
        "icon": "$(search)"
      },
      {
        "command": "orthos.shutdown",
        "title": "Orthos: Shutdown Daemon",
        "icon": "$(stop)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "orthos.initialize",
          "when": "resourceLangId == orthos",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "Orthos",
      "properties": {
        "orthos.daemonPath": {
          "type": "string",
          "default": "",
          "description": "Path to orthos-daemon binary. Leave empty to auto-detect."
        },
        "orthos.autoInitialize": {
          "type": "boolean",
          "default": true,
          "description": "Automatically initialize the daemon when opening .orth files."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src --ext ts"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "eslint": "^8.54.0",
    "typescript": "^5.3.0"
  }
}
