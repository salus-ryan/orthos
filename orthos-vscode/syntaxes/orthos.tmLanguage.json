{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Orthos",
  "scopeName": "source.orthos",
  "patterns": [
    { "include": "#comments" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#operators" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#constants" },
    { "include": "#identifiers" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.orthos",
          "match": "//.*$"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.orthos",
          "match": "\\b(Boundary|Flux|Law|Manifest|Diode)\\b"
        },
        {
          "name": "keyword.operator.logical.orthos",
          "match": "\\b(implies|and|or|not)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.orthos",
          "match": "\\b(Int|Bool|String|List)\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.comparison.orthos",
          "match": "(==|!=|<=|>=|<|>)"
        },
        {
          "name": "keyword.operator.logical.orthos",
          "match": "(&&|\\|\\||!)"
        },
        {
          "name": "keyword.operator.arithmetic.orthos",
          "match": "(\\+|-|\\*|/|%)"
        },
        {
          "name": "keyword.operator.causal.orthos",
          "match": "(<->|->)"
        },
        {
          "name": "keyword.operator.assignment.orthos",
          "match": "="
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.orthos",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.orthos",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.orthos",
          "match": "-?\\b[0-9]+\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.boolean.orthos",
          "match": "\\b(true|false)\\b"
        }
      ]
    },
    "identifiers": {
      "patterns": [
        {
          "name": "entity.name.type.orthos",
          "match": "(?<=Boundary\\s+)[A-Z][a-zA-Z0-9_]*"
        },
        {
          "name": "variable.other.orthos",
          "match": "(?<=Flux\\s+)[a-zA-Z_][a-zA-Z0-9_]*"
        },
        {
          "name": "entity.name.function.orthos",
          "match": "(?<=Law\\s+)[a-zA-Z_][a-zA-Z0-9_]*"
        }
      ]
    }
  }
}
