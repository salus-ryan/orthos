# ORTHOS Platform Environment Configuration

# Home Assistant Connection
HASS_URL=http://homeassistant.local:8123
HASS_TOKEN=your_long_lived_access_token_here

# Comfort Parameters
COMFORT_TEMP_MIN=20
COMFORT_TEMP_MAX=24
COMFORT_LIGHT_MIN=30
COMFORT_HUMIDITY_MIN=30
COMFORT_HUMIDITY_MAX=60

# Control Loop
CONTROL_INTERVAL=10
