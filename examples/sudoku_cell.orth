// ORTHOS Example: Sudoku Cell Constraints (Omni Mode)
// Demonstrates constraint satisfaction for puzzle solving.
// A simplified 4x4 Sudoku to show the concept.

Boundary Sudoku4x4 <-> {
    // 4x4 grid - each cell is 1-4
    Flux c00 : Int  Flux c01 : Int  Flux c02 : Int  Flux c03 : Int
    Flux c10 : Int  Flux c11 : Int  Flux c12 : Int  Flux c13 : Int
    Flux c20 : Int  Flux c21 : Int  Flux c22 : Int  Flux c23 : Int
    Flux c30 : Int  Flux c31 : Int  Flux c32 : Int  Flux c33 : Int
    
    // All cells must be 1-4
    Law Range00 : c00 >= 1 && c00 <= 4
    Law Range01 : c01 >= 1 && c01 <= 4
    Law Range02 : c02 >= 1 && c02 <= 4
    Law Range03 : c03 >= 1 && c03 <= 4
    Law Range10 : c10 >= 1 && c10 <= 4
    Law Range11 : c11 >= 1 && c11 <= 4
    Law Range12 : c12 >= 1 && c12 <= 4
    Law Range13 : c13 >= 1 && c13 <= 4
    Law Range20 : c20 >= 1 && c20 <= 4
    Law Range21 : c21 >= 1 && c21 <= 4
    Law Range22 : c22 >= 1 && c22 <= 4
    Law Range23 : c23 >= 1 && c23 <= 4
    Law Range30 : c30 >= 1 && c30 <= 4
    Law Range31 : c31 >= 1 && c31 <= 4
    Law Range32 : c32 >= 1 && c32 <= 4
    Law Range33 : c33 >= 1 && c33 <= 4
    
    // Row uniqueness (all different in each row)
    Law Row0 : c00 != c01 && c00 != c02 && c00 != c03 && c01 != c02 && c01 != c03 && c02 != c03
    Law Row1 : c10 != c11 && c10 != c12 && c10 != c13 && c11 != c12 && c11 != c13 && c12 != c13
    Law Row2 : c20 != c21 && c20 != c22 && c20 != c23 && c21 != c22 && c21 != c23 && c22 != c23
    Law Row3 : c30 != c31 && c30 != c32 && c30 != c33 && c31 != c32 && c31 != c33 && c32 != c33
    
    // Column uniqueness
    Law Col0 : c00 != c10 && c00 != c20 && c00 != c30 && c10 != c20 && c10 != c30 && c20 != c30
    Law Col1 : c01 != c11 && c01 != c21 && c01 != c31 && c11 != c21 && c11 != c31 && c21 != c31
    Law Col2 : c02 != c12 && c02 != c22 && c02 != c32 && c12 != c22 && c12 != c32 && c22 != c32
    Law Col3 : c03 != c13 && c03 != c23 && c03 != c33 && c13 != c23 && c13 != c33 && c23 != c33
    
    // 2x2 box uniqueness (top-left, top-right, bottom-left, bottom-right)
    Law Box00 : c00 != c01 && c00 != c10 && c00 != c11 && c01 != c10 && c01 != c11 && c10 != c11
    Law Box01 : c02 != c03 && c02 != c12 && c02 != c13 && c03 != c12 && c03 != c13 && c12 != c13
    Law Box10 : c20 != c21 && c20 != c30 && c20 != c31 && c21 != c30 && c21 != c31 && c30 != c31
    Law Box11 : c22 != c23 && c22 != c32 && c22 != c33 && c23 != c32 && c23 != c33 && c32 != c33
}

Boundary Main {
    Manifest execution {
        // Provide some initial clues
        Flux puzzle = Sudoku4x4(c00=1, c11=2, c22=3, c33=4).c01
    }
}
